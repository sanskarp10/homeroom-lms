# Homeroom client configuration (all optional)
# ---------------------------------------------------------------------------
# Leave everything empty when the API serves the built app (single-host deploy)
# or when you use `npm run dev` (Vite proxies /api, /media and /socket.io).

# Only set this when the frontend is hosted on a different domain from the API,
# for example Vercel + Render. No trailing slash. Example: https://api.example.com
VITE_API_URL=

# Dev only: where `npm run dev` forwards API calls. Default http://localhost:4000
VITE_DEV_API_TARGET=
