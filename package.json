{
  "name": "homeroom-lms",
  "version": "1.0.0",
  "private": true,
  "description": "Homeroom - a full online school: courses, video lessons, live classes, quizzes, certificates and instructor earnings.",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c green,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "worker": "npm run worker -w server",
    "test": "npm run test -w server",
    "doctor": "npm run doctor -w server",
    "seed:reset": "npm run seed -w server -- --reset",
    "create-admin": "npm run create-admin -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
