# Homeroom server configuration
# ---------------------------------------------------------------------------
# The app boots with this file untouched: every value that still starts with
# REPLACE_ME is treated as "not set" and a local fallback is used instead.
# SETUP_GUIDE.md explains, step by step, how to get each real value.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Where the React app is served from (used for CORS, Stripe redirects, certificate links)
CLIENT_URL=http://localhost:5173
# Public base URL of this API
PUBLIC_URL=http://localhost:4000

# --- Auth -------------------------------------------------------------------
# Long random string. `npm run setup` generates one for you.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# --- MongoDB ----------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/homeroom   Atlas: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/homeroom
MONGO_URI=mongodb://127.0.0.1:27017/homeroom
# Development only: if MONGO_URI is unreachable, start an embedded MongoDB (data in server/.data)
MONGO_MEMORY_FALLBACK=true
# Load demo courses and accounts when the database is empty
AUTO_SEED=true

# --- Redis + BullMQ (video processing queue) ---------------------------------
# Local: redis://127.0.0.1:6379   Hosted (Upstash etc.): rediss://default:PASSWORD@host:6379
REDIS_URL=redis://127.0.0.1:6379
# auto = BullMQ when Redis is reachable, otherwise in-process (development only) | bullmq | inline
QUEUE_DRIVER=auto
# true = the API process also runs the video worker. false = run `npm run worker` separately.
RUN_WORKER_IN_API=true
TRANSCODE_CONCURRENCY=1

# --- FFmpeg -----------------------------------------------------------------
# Leave empty to use the bundled binary (ffmpeg-static). Set a path to use your own build.
FFMPEG_PATH=
# x264 preset: ultrafast | veryfast | fast | medium (slower = smaller files)
FFMPEG_PRESET=veryfast
MAX_UPLOAD_MB=1024

# --- Storage: AWS S3 + CloudFront ---------------------------------------------
# auto = S3/CloudFront when the four values below are real, otherwise local disk | s3 | local
STORAGE_DRIVER=auto
AWS_REGION=REPLACE_ME_AWS_REGION
AWS_ACCESS_KEY_ID=REPLACE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_ME_AWS_SECRET_ACCESS_KEY
S3_BUCKET=REPLACE_ME_S3_BUCKET_NAME
# Domain only, no https:// (example: d1234abcd.cloudfront.net)
CLOUDFRONT_DOMAIN=REPLACE_ME_CLOUDFRONT_DOMAIN

# --- Payments: Stripe (test mode) ---------------------------------------------
# Leave as placeholders to use the built-in test gateway (card 4242 4242 4242 4242).
STRIPE_SECRET_KEY=REPLACE_ME_sk_test_xxx
STRIPE_WEBHOOK_SECRET=REPLACE_ME_whsec_xxx
# Share of each sale kept by the platform; the rest is instructor earnings
PLATFORM_FEE_PERCENT=20
CURRENCY=usd

# --- Live classes: WebRTC ICE servers -------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
# TURN is needed for students behind strict firewalls. Leave as placeholders for local use.
TURN_URL=REPLACE_ME_turn:your.turn.host:3478
TURN_USERNAME=REPLACE_ME_TURN_USERNAME
TURN_CREDENTIAL=REPLACE_ME_TURN_CREDENTIAL
